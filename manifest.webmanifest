{
  "name": "FemboyChat",
  "short_name": "FemboyChat",
  "description": "FemboyChat — тёплый и современный мессенджер: вход без пароля, реальное время, красивые настройки.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#fff5fb",
  "theme_color": "#ff9ecd",
  "categories": ["social", "communication"],
  "icons": [
    {
      "src": "/icon-app.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "type": "image/png",
      "sizes": "600x598",
      "purpose": "any"
    },
    {
      "src": "/icon-mask.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "maskable"
    }
  ]
}
